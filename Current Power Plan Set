# ===== SETUP =====
Write-Host "=== Power Plan Information ===" -ForegroundColor Green

# ===== GET ALL POWER PLANS =====
Write-Host "`nAll available power plans:" -ForegroundColor Yellow
Get-WmiObject -Namespace root\cimv2\power -Class Win32_PowerPlan | Select-Object ElementName, @{Name="IsActive";Expression={$_.IsActive}} | Format-Table

# ===== GET ACTIVE POWER PLAN =====
Write-Host "`nActive power plan:" -ForegroundColor Cyan
$activePlan = Get-WmiObject -Namespace root\cimv2\power -Class Win32_PowerPlan -Filter "IsActive=true"
Write-Host "  Name: $($activePlan.ElementName)" -ForegroundColor Green

# ===== GET POWER SETTINGS =====
Write-Host "`nCurrent power settings:" -ForegroundColor Yellow
powercfg /query SCHEME_CURRENT | Select-String -Pattern "Power Scheme|Subgroup of Power|Power Setting" | Format-Table

Write-Host "`n=== Complete ===" -ForegroundColor Green
