# BEFORE CHANGE THESE VALUES:
# $interfaceIndex = 2  # Your adapter number
# $newGateway = "192.168.1.1"  # Your new gateway


# ===== SETUP =====
Write-Host "=== Modify Default Gateway ===" -ForegroundColor Green

# ===== GET ADAPTER INFO =====
Write-Host "`nAvailable adapters:" -ForegroundColor Yellow
Get-NetAdapter | Select-Object InterfaceIndex, Name, Status | Format-Table

# ===== SET VARIABLES =====
$interfaceIndex = 2  # Change this to your adapter number
$newGateway = "192.168.1.1"  # Change this to new gateway IP

Write-Host "`nAdapter Index: $interfaceIndex" -ForegroundColor Cyan
Write-Host "New Gateway: $newGateway`n" -ForegroundColor Cyan

# ===== REMOVE OLD DEFAULT GATEWAY =====
Write-Host "Removing old default gateway..." -ForegroundColor Yellow
Remove-NetRoute -DestinationPrefix "0.0.0.0/0" -InterfaceIndex $interfaceIndex -Confirm:$false -ErrorAction SilentlyContinue
Write-Host "✓ Old gateway removed" -ForegroundColor Green

# ===== ADD NEW DEFAULT GATEWAY =====
Write-Host "`nAdding new default gateway..." -ForegroundColor Yellow
New-NetRoute -DestinationPrefix "0.0.0.0/0" -NextHop $newGateway -InterfaceIndex $interfaceIndex -RouteMetric 256
Write-Host "✓ New gateway added" -ForegroundColor Green

# ===== VERIFY CHANGE =====
Write-Host "`nVerifying change..." -ForegroundColor Cyan
Get-NetRoute -DestinationPrefix "0.0.0.0/0" -InterfaceIndex $interfaceIndex | Select-Object DestinationPrefix, NextHop, InterfaceIndex, RouteMetric | Format-Table

Write-Host "`n=== Complete ===" -ForegroundColor Green
