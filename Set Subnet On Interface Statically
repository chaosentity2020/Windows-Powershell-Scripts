# Get interface with below script
Write-Host "`nAvailable adapters:" -ForegroundColor Yellow
Get-NetAdapter | Select-Object InterfaceIndex, Name, Status, MacAddress, @{Name="IP Address";Expression={(Get-NetIPAddress -InterfaceIndex $_.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue).IPAddress}}, @{Name="Current Gateway";Expression={(Get-NetRoute -InterfaceIndex $_.InterfaceIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue).NextHop}} | Format-Table -AutoSize


