$interfaceIndex = 13; $ipAddress = "10.13.170.133"; $subnetMask = "255.255.255.0"; New-NetIPAddress -InterfaceIndex $interfaceIndex -IPAddress $ipAddress -PrefixLength 24 -AddressFamily IPv4 -ErrorAction SilentlyContinue; Write-Host "IP: $ipAddress / Subnet: $subnetMask set on interface $interfaceIndex" -ForegroundColor Green
